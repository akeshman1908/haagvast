import type { Metadata } from "next";
import type { ReactNode } from "react";

const siteUrl =
  process.env.NEXT_PUBLIC_SITE_URL?.replace(/\/$/, "") ||
  "https://haagvast.nl";

type Region = {
  name: string;
  description: string;
};

const regions: Record<string, Region> = {
  "den-haag": {
    name: "Den Haag",
    description:
      "Uw huis verkopen in Den Haag? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  delft: {
    name: "Delft",
    description:
      "Uw huis verkopen in Delft? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  voorburg: {
    name: "Voorburg",
    description:
      "Uw huis verkopen in Voorburg? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  leidschendam: {
    name: "Leidschendam",
    description:
      "Uw huis verkopen in Leidschendam? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  rijswijk: {
    name: "Rijswijk",
    description:
      "Uw huis verkopen in Rijswijk? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  wassenaar: {
    name: "Wassenaar",
    description:
      "Uw huis verkopen in Wassenaar? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  zoetermeer: {
    name: "Zoetermeer",
    description:
      "Uw huis verkopen in Zoetermeer? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  "pijnacker-nootdorp": {
    name: "Pijnacker-Nootdorp",
    description:
      "Uw huis verkopen in Pijnacker-Nootdorp? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  "midden-delfland": {
    name: "Midden-Delfland",
    description:
      "Uw huis verkopen in Midden-Delfland? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  westland: {
    name: "Westland",
    description:
      "Uw huis verkopen in Westland? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
  voorschoten: {
    name: "Voorschoten",
    description:
      "Uw huis verkopen in Voorschoten? Haagvast koopt woningen rechtstreeks. Ontvang snel en vrijblijvend een bod op uw woning.",
  },
};

type RegionLayoutProps = {
  children: ReactNode;
  params: Promise<{
    slug: string;
  }>;
};

export async function generateMetadata({
  params,
}: RegionLayoutProps): Promise<Metadata> {
  const { slug } = await params;

  const region = regions[slug];

  if (!region) {
    return {
      title: "Huis verkopen | Haagvast",
      description:
        "Verkoop uw woning rechtstreeks aan Haagvast. Snel, duidelijk en zonder traditionele verkoopprocedure.",
    };
  }

  const canonicalUrl = `${siteUrl}/regio/${slug}`;

  return {
    title: `Huis verkopen in ${region.name} | Haagvast`,
    description: region.description,

    alternates: {
      canonical: canonicalUrl,
    },

    openGraph: {
      title: `Huis verkopen in ${region.name} | Haagvast`,
      description: region.description,
      url: canonicalUrl,
      siteName: "Haagvast",
      locale: "nl_NL",
      type: "website",
    },

    twitter: {
      card: "summary_large_image",
      title: `Huis verkopen in ${region.name} | Haagvast`,
      description: region.description,
    },

    robots: {
      index: true,
      follow: true,
    },
  };
}

export default async function RegionLayout({
  children,
  params,
}: RegionLayoutProps) {
  const { slug } = await params;

  const region = regions[slug];

  const regionName = region?.name ?? slug;

  const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Haagvast",
        item: siteUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Regio Haaglanden",
        item: `${siteUrl}/regio`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: regionName,
        item: `${siteUrl}/regio/${slug}`,
      },
    ],
  };

  const serviceStructuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `Huis verkopen in ${regionName}`,
    description:
      region?.description ??
      `Haagvast koopt woningen in ${regionName} en omgeving.`,
    url: `${siteUrl}/regio/${slug}`,
    areaServed: {
      "@type": "City",
      name: regionName,
    },
    provider: {
      "@type": "Organization",
      name: "Haagvast",
      url: siteUrl,
    },
    serviceType: "Woning verkopen",
  };

  const jsonLd = [
    breadcrumbStructuredData,
    serviceStructuredData,
  ];

  return (
    <>
      <script
        type="application/ld+json"
        dangerouslySetInnerHTML={{
          __html: JSON.stringify(jsonLd).replace(/</g, "\\u003c"),
        }}
      />

      {children}
    </>
  );
}
