import type { Metadata } from "next";

import ContentSection from "@/components/sections/ContentSection/ContentSection";

import { siteConfig } from "@/config/site";

const canonicalUrl = `${siteConfig.url}/privacy`;

export const metadata: Metadata = {
  title: "Privacyverklaring | HaagVast",
  description:
    "Lees hoe HaagVast omgaat met persoonsgegevens die u via de website verstrekt.",
  alternates: {
    canonical: canonicalUrl,
  },
  robots: {
    index: true,
    follow: true,
  },
};

export default function PrivacyPage() {
  return (
    <>
      <ContentSection
        eyebrow="Privacy"
        title="Privacyverklaring"
        description="HaagVast gaat zorgvuldig om met persoonsgegevens die u via deze website verstrekt."
        content={
          <>
            <h2>Welke gegevens verwerken we?</h2>

            <p>
              Wanneer u een woning aanmeldt of contact met ons opneemt, kunnen
              we gegevens verwerken zoals uw naam, contactgegevens,
              adresgegevens van de woning en informatie die u zelf over de
              woning of uw situatie verstrekt.
            </p>

            <h2>Waarom verwerken we deze gegevens?</h2>

            <p>
              We gebruiken deze gegevens om uw aanvraag te behandelen, contact
              met u op te nemen, de woning globaal te beoordelen en eventuele
              vervolgstappen met u te bespreken.
            </p>

            <h2>Hoe lang bewaren we gegevens?</h2>

            <p>
              Persoonsgegevens worden niet langer bewaard dan redelijkerwijs
              nodig is voor het doel waarvoor deze zijn verzameld, tenzij een
              wettelijke bewaarplicht van toepassing is.
            </p>

            <h2>Delen met derden</h2>

            <p>
              Persoonsgegevens worden niet zonder reden verkocht of verstrekt
              aan derden. Wanneer voor onze dienstverlening externe partijen
              nodig zijn, worden alleen gegevens gedeeld die daarvoor
              noodzakelijk zijn.
            </p>

            <h2>Beveiliging</h2>

            <p>
              We nemen passende technische en organisatorische maatregelen om
              persoonsgegevens te beschermen tegen verlies, onbevoegde toegang
              of onrechtmatige verwerking.
            </p>

            <h2>Uw rechten</h2>

            <p>
              U kunt vragen welke persoonsgegevens we van u verwerken en, waar
              van toepassing, verzoeken om correctie of verwijdering van deze
              gegevens.
            </p>

            <h2>Contact</h2>

            <p>
              Heeft u vragen over deze privacyverklaring of de verwerking van
              uw persoonsgegevens? Neem dan contact met ons op via de
              contactpagina.
            </p>
          </>
        }
        cta={{
          label: "Neem contact op",
          href: "/contact",
        }}
      />
    </>
  );
}
