.werkwijze-page {
  &__prose {
    display: grid;
    gap: var(--spacing-4);
    max-width: 43rem;

    p {
      margin: 0;
      color: var(--color-text-soft);
      font-size: 0.94rem;
      line-height: 1.85;
    }
  }

  &__info-panel {
    padding: var(--spacing-6);
    border-top: 2px solid var(--color-accent-500);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    background: var(--color-paper);
  }

  &__panel-label {
    display: block;
    margin-bottom: var(--spacing-5);
    color: var(--color-accent-700);
    font-size: 0.68rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  &__checklist {
    display: grid;
    gap: var(--spacing-4);
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: var(--spacing-3);
      align-items: start;
      color: var(--color-text);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    svg {
      margin-top: 0.08rem;
      color: var(--color-primary-700);
    }
  }

  &__panel-note {
    margin:
      var(--spacing-5)
      0
      0;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  &__comparison {
    width: 100%;
    border-top: 1px solid var(--color-border-dark);
  }

  &__comparison-row {
    display: grid;
    grid-template-columns:
      minmax(12rem, 0.8fr)
      minmax(0, 1.2fr);
    gap: var(--spacing-8);
    align-items: start;
    padding-block: var(--spacing-6);
    border-bottom: 1px solid var(--color-border);

    h3 {
      max-width: 18rem;
      margin: var(--spacing-2) 0 0;
      color: var(--color-text);
      font-family: var(--font-family-display);
      font-size: 1.25rem;
      font-weight: 400;
      line-height: 1.35;
    }

    p {
      max-width: 34rem;
      margin: 0;
      color: var(--color-text-soft);
      font-size: 0.86rem;
      line-height: 1.75;
    }
  }

  &__comparison-label {
    color: var(--color-accent-700);
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  &__aside-quote {
    padding:
      var(--spacing-5)
      0
      var(--spacing-5)
      var(--spacing-5);
    border-left: 2px solid var(--color-accent-500);

    span {
      color: var(--color-accent-700);
      font-size: 0.65rem;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    p {
      max-width: 22rem;
      margin: var(--spacing-3) 0 0;
      color: var(--color-text);
      font-family: var(--font-family-display);
      font-size: 1.15rem;
      line-height: 1.55;
    }
  }
}

@media (max-width: 700px) {
  .werkwijze-page {
    &__info-panel {
      padding: var(--spacing-5);
    }

    &__comparison-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-3);
      padding-block: var(--spacing-5);

      h3 {
        max-width: none;
        font-size: 1.15rem;
      }

      p {
        max-width: none;
        font-size: 0.82rem;
      }
    }

    &__aside-quote {
      padding-left: var(--spacing-4);

      p {
        max-width: none;
        font-size: 1.05rem;
      }
    }
  }
}

@media (max-width: 420px) {
  .werkwijze-page {
    &__prose p {
      font-size: 0.88rem;
      line-height: 1.75;
    }

    &__info-panel {
      padding: var(--spacing-4);
    }

    &__checklist {
      gap: var(--spacing-3);

      li {
        font-size: 0.82rem;
      }
    }

    &__comparison-row {
      padding-block: var(--spacing-4);

      h3 {
        font-size: 1.08rem;
      }

      p {
        font-size: 0.79rem;
        line-height: 1.68;
      }
    }
  }
}
