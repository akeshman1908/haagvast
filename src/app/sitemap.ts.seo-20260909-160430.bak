import type { MetadataRoute } from "next";

const siteUrl =
  process.env.NEXT_PUBLIC_SITE_URL?.replace(/\/$/, "") ||
  "https://haagvast.nl";

const regionSlugs = [
  "den-haag",
  "delft",
  "voorburg",
  "leidschendam",
  "rijswijk",
  "wassenaar",
  "zoetermeer",
  "pijnacker-nootdorp",
  "midden-delfland",
  "westland",
  "voorschoten",
];

export default function sitemap(): MetadataRoute.Sitemap {
  const now = new Date();

  const staticPages: MetadataRoute.Sitemap = [
    {
      url: siteUrl,
      lastModified: now,
      changeFrequency: "weekly",
      priority: 1,
    },
    {
      url: `${siteUrl}/regio`,
      lastModified: now,
      changeFrequency: "weekly",
      priority: 0.9,
    },
  ];

  const regionPages: MetadataRoute.Sitemap = regionSlugs.map((slug) => ({
    url: `${siteUrl}/regio/${slug}`,
    lastModified: now,
    changeFrequency: "weekly",
    priority: 0.8,
  }));

  return [...staticPages, ...regionPages];
}

