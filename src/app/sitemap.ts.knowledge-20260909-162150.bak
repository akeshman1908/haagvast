import type { MetadataRoute } from "next";

const siteUrl =
  process.env.NEXT_PUBLIC_SITE_URL?.replace(/\/$/, "") ||
  "https://haagvast.nl";

type SitemapPage = {
  path: string;
  priority: number;
  changeFrequency:
    | "daily"
    | "weekly"
    | "monthly"
    | "yearly";
};

