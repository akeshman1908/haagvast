import type { Metadata } from "next";

import ContentSection from "@/components/sections/ContentSection/ContentSection";

import { siteConfig } from "@/config/site";

const canonicalUrl = `${siteConfig.url}/cookies`;

export const metadata: Metadata = {
  title: "Cookieverklaring | HaagVast",
  description:
    "Lees welke cookies en vergelijkbare technieken op de website van HaagVast kunnen worden gebruikt.",
  alternates: {
    canonical: canonicalUrl,
  },
  robots: {
    index: true,
    follow: true,
  },
};

export default function CookiesPage() {
  return (
    <>
      <ContentSection
        eyebrow="Cookies"
        title="Cookieverklaring"
        description="Op deze pagina leest u hoe HaagVast omgaat met cookies en vergelijkbare technieken."
        content={
          <>
            <h2>Wat zijn cookies?</h2>

            <p>
              Cookies zijn kleine bestanden die tijdens het bezoeken van een
              website op uw apparaat kunnen worden opgeslagen. Ze kunnen
              bijvoorbeeld worden gebruikt om een website technisch goed te
              laten functioneren.
            </p>

            <h2>Functionele cookies</h2>

            <p>
              Functionele cookies zijn nodig om onderdelen van de website
              correct te laten werken. Hiervoor is doorgaans geen toestemming
              nodig wanneer deze cookies uitsluitend technisch noodzakelijk
              zijn.
            </p>

            <h2>Analyse en statistieken</h2>

            <p>
              Wanneer HaagVast analysetools gebruikt, kunnen gegevens worden
              verwerkt om inzicht te krijgen in het gebruik en functioneren van
              de website.
            </p>

            <p>
              Niet-noodzakelijke cookies worden alleen gebruikt wanneer dit
              volgens de toepasselijke regels is toegestaan en, wanneer nodig,
              nadat hiervoor toestemming is verkregen.
            </p>

            <h2>Cookies beheren</h2>

            <p>
              Via uw browser kunt u opgeslagen cookies bekijken, blokkeren of
              verwijderen. Houd er rekening mee dat het blokkeren van
              functionele cookies invloed kan hebben op de werking van een
              website.
            </p>

            <h2>Wijzigingen</h2>

            <p>
              Deze cookieverklaring kan worden aangepast wanneer de website,
              gebruikte technieken of toepasselijke regels veranderen.
            </p>

            <h2>Vragen?</h2>

            <p>
              Heeft u vragen over cookies of privacy op deze website? Neem dan
              contact met ons op via de contactpagina.
            </p>
          </>
        }
        cta={{
          label: "Bekijk privacyverklaring",
          href: "/privacy",
        }}
      />
    </>
  );
